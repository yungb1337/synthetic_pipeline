        },
        {
          "id": "d-e546a005ed1bb895/b10_0008",
          "kind": "heading",
          "text": "Ethics statement",
          "bbox": {
            "x0": 304.425,
            "y0": 387.85999999999996,
            "x1": 408.44250000000005,
            "y1": 400.37449999999995
          },
          "page": 10,
          "confidence": 1.0,
          "font_size": null,
          "bold": null,
          "source": "docling",
          "ocr_engine": null
        },
        {
          "id": "d-e546a005ed1bb895/b10_0009",
          "kind": "paragraph",
          "text": "The studies involving humans were approved by Ethics Committees at Guangdong Provincial Hospital of Chinese Medicine. The studies were conducted in accordance with the local legislation and institutional requirements. The participants provided their written informed consent to participate in this study.",
          "bbox": {
            "x0": 304.423,
            "y0": 416.752,
            "x1": 545.3710000000003,
            "y1": 473.86590123456784
          },
          "page": 10,
