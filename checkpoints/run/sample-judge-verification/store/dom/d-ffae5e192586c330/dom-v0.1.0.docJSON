        },
        {
          "id": "d-ffae5e192586c330/b06_0001",
          "kind": "caption",
          "text": "TABLE  3  Comparison  of 3D-master  VITA  values among  two  groups  during  different time points.",
          "bbox": {
            "x0": 49.6063,
            "y0": 74.54899999999998,
            "x1": 291.9510460500001,
            "y1": 88.60241461538465
          },
          "page": 6,
          "confidence": 1.0,
          "font_size": null,
          "bold": null,
          "source": "docling",
          "ocr_engine": null
        },
        {
          "id": "d-ffae5e192586c330/b06_0002",
          "kind": "paragraph",
          "text": "** p < 0.01.",
          "bbox": {
            "x0": 49.6063,
            "y0": 212.17811760000006,
            "x1": 75.19609790482,
            "y1": 219.82552569999996
          },
          "page": 6,
          "confidence": 1.0,
          "font_size": null,
          "bold": null,
