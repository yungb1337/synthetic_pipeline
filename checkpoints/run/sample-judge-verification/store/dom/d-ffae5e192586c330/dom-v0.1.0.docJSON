        },
        {
          "id": "d-ffae5e192586c330/b01_0020",
          "kind": "heading",
          "text": "Introduction",
          "bbox": {
            "x0": 219.685,
            "y0": 705.818,
            "x1": 298.26438924999997,
            "y1": 718.697
          },
          "page": 1,
          "confidence": 1.0,
          "font_size": null,
          "bold": null,
          "source": "docling",
          "ocr_engine": null
        },
        {
          "id": "d-ffae5e192586c330/b01_0021",
          "kind": "paragraph",
          "text": "Extrinsic tooth discoloration refers to the phenomenon where teeth exhibit a change in coloration due to  the  external  accumulation  of  pigments  from substances  such as  food, beverages, and tobacco on the enamel's surface or within its composition (1). As people's demand for an aesthetically pleasing smile has increased, there has been a sharp rise in",
          "bbox": {
            "x0": 219.6846,
            "y0": 733.492,
            "x1": 547.6510152,
            "y1": 778.2130999999999
          },
          "page": 1,
          "confidence": 1.0,
          "font_size": null,
          "bold": null,
          "source": "docling",
          "ocr_engine": null
        }
      ],
      "tables": [],
      "images": [
        {
          "id": "d-ffae5e192586c330/i0_1",
          "page": 1,
          "bbox": {
            "x0": 48.48848511701559,
            "y0": 47.968312229248795,
            "x1": 167.49335760846733,
            "y1": 78.57575620814487
          },
          "storage_ref": "images/d-ffae5e192586c330/d6c859b4e6727c9482167f1bff48e36b22b0bb6375eb31228c65d82e16952d18.png",
