        },
        {
          "id": "d-ffae5e192586c330/b01_0019",
          "kind": "paragraph",
          "text": "hydrogen  peroxide, randomized  controlled  trial, safety, tooth whitening, tooth discoloration",
          "bbox": {
            "x0": 219.685,
            "y0": 664.6180721999999,
            "x1": 547.51349489259,
            "y1": 683.0293026153846
          },
          "page": 1,
          "confidence": 1.0,
