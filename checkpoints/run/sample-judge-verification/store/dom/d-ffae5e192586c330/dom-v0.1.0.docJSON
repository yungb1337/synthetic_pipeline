      "blocks": [
        {
          "id": "d-ffae5e192586c330/b06_0000",
          "kind": "paragraph",
          "text": "Wang et al.",
          "bbox": {
            "x0": 49.6066,
            "y0": 35.4481487999999,
            "x1": 372.67446692578034,
            "y1": 42.12595799999997
          },
