          "bbox": {
            "x0": 305.85379,
            "y0": 680.1469791,
            "x1": 556.9194994000001,
            "y1": 713.6491066333333
          },
          "page": 1,
          "confidence": 1.0,
          "font_size": null,
          "bold": null,
          "source": "docling",
