                {
                  "text": "",
                  "bbox": null
                }
              ],
              "bbox": {
                "x0": 96.03727599999999,
                "y0": 619.1969879999999,
                "x1": 528.0372840000002,
                "y1": 680.267057
              }
            }
          ],
          "source": "docling",
          "confidence": 1.0,
          "caption": "Figure 1. Interpretation of strong and conditional recommendations."
        }
      ],
