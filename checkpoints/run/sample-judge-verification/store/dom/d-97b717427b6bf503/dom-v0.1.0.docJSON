      ],
      "tables": [],
      "images": [
        {
          "id": "d-97b717427b6bf503/i0_16",
          "page": 16,
          "bbox": {
            "x0": 469.1765708842907,
            "y0": 735.3488117956472,
            "x1": 556.5898979199542,
            "y1": 747.1988810222753
          },
          "storage_ref": "images/d-97b717427b6bf503/5b63c661e8bfc40199bc7f5ba5a335c07081ed76381a9cab15fc7ede098a760c.png",
          "mime": "image/png",
          "checksum": "5b63c661e8bfc40199bc7f5ba5a335c07081ed76381a9cab15fc7ede098a760c",
