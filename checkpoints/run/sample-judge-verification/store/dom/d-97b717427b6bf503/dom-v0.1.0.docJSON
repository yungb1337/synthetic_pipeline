        {
          "id": "d-97b717427b6bf503/b27_0002",
          "kind": "paragraph",
          "text": "*Also included in PICO 9.",
          "bbox": {
            "x0": 43.313824,
            "y0": 512.9716450999999,
            "x1": 115.52565539999999,
            "y1": 519.0760716333333
