        {
          "id": "d-730339a6f12064a3/b01_0018",
          "kind": "paragraph",
          "text": "*Corresponding author: Albert Assad, MD, Incyte Corporation, Oncology Drug Development, 1801 Augustine Cut-Off, Wilmington, DE 19803, United States (aassad@incyte.com).",
          "bbox": {
            "x0": 48.189172989999996,
            "y0": 401.71834056999995,
            "x1": 546.82214,
            "y1": 418.73572784999993
          },
          "page": 1,
          "confidence": 1.0,
