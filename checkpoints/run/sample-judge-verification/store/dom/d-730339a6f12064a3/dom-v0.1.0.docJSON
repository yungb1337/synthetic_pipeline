        },
        {
          "id": "d-730339a6f12064a3/b10_0006",
          "kind": "paragraph",
          "text": "The authors thank the patients, investigators, and site personnel who participated in this study. This study was funded by Incyte Corporation  (Wilmington,  DE).  Medical  writing  assistance  was provided by Steven Moore, PhD, of Envision Ignite, an Envision Medical  Communications  Agency,  a  part  of  Envision  Pharma Group, and funded by Incyte Corporation.",
          "bbox": {
            "x0": 42.51959999999997,
            "y0": 605.606,
            "x1": 288.12059999999997,
            "y1": 671.6353999999999
          },
          "page": 10,
